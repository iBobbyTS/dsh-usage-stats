{
  "name": "@ychris12138/dsh-usage-stats",
  "description": "Token usage, provider accounts, session cost estimates, budgets, and exports for the dsh web GUI",
  "version": "0.3.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-usage-stats.git"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-usage-stats#readme",
  "bugs": "https://github.com/iBobbyTS/dsh-usage-stats/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-usage"
  ],
  "bin": {
    "dsh-usage-stats-install": "scripts/install.mjs"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "docs/images/usage-panel.svg",
    "docs/release-checklist.md",
    "docs/release-plan-v0.3.6.md",
    "docs/release-notes-v0.3.0.md",
    "docs/release-notes-v0.3.1.md",
    "docs/release-notes-v0.3.2.md",
    "docs/release-notes-v0.3.3.md",
    "docs/release-notes-v0.3.4.md",
    "docs/release-notes-v0.3.5.md",
    "docs/release-notes-v0.3.6.md",
    "scripts/install.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/release-notes-v0.3.7.md",
    "docs/release-plan-v0.3.7.md",
    "docs/pr153-accounting-review.md",
    "docs/provider-model-usage.md",
    "docs/opencode-usage-sources.md",
    "docs/credit-balance-service-contract.md",
    "docs/follow-current-session.md",
    "docs/quota-service-contract.md",
    "docs/configuration.md",
    "docs/usage-and-api.md",
    "docs/development.md",
    "src"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./quota": {
      "types": "./lib/quota.d.ts",
      "default": "./lib/quota.js"
    },
    "./pricing": "./lib/pricing.js",
    "./usage": "./lib/usage.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs all",
    "check:release": "node scripts/check-release-metadata.mjs",
    "release:sync": "node scripts/sync-release-version.mjs",
    "test": "node scripts/check.mjs test",
    "test:bundle": "node scripts/test-bundle.mjs",
    "test:client": "node scripts/smoke-client.mjs",
    "test:overlay": "node scripts/test-overlay-layering.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:export": "node scripts/test-export.mjs",
    "test:provider-identity": "node scripts/test-provider-identity.mjs",
    "test:provider-options": "node scripts/test-provider-options.mjs",
    "test:pricing": "node scripts/test-pricing.mjs",
    "test:billing": "node scripts/test-billing.mjs",
    "test:balance": "node scripts/test-balance.mjs",
    "test:subscriptions": "node scripts/test-subscriptions.mjs",
    "test:accounts": "node scripts/test-accounts.mjs",
    "test:codearts-credits": "node scripts/test-codearts-credits.mjs",
    "validate:live": "node scripts/validate-fold.mjs && node scripts/verify-raw.mjs",
    "test:providers-hub": "node scripts/test-providers-hub-integration.mjs",
    "test:ark-coding-plan": "node scripts/test-ark-coding-plan.mjs",
    "test:follow-session": "node scripts/test-follow-session.mjs",
    "test:quota": "node --test scripts/test-quota.mjs",
    "test:quota-integration": "node scripts/test-quota-integration.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:dist": "node scripts/check.mjs dist",
    "test:behavior": "pnpm run test:bundle && pnpm run test:client && pnpm run test:overlay && pnpm run test:server && pnpm run test:export && pnpm run test:provider-identity && pnpm run test:provider-options && pnpm run test:pricing && pnpm run test:billing && pnpm run test:balance && pnpm run test:subscriptions && pnpm run test:accounts && pnpm run test:codearts-credits && pnpm run test:install && pnpm run test:ark-coding-plan && pnpm run test:follow-session && pnpm run test:quota"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@deepseek-ai/cordis": "4.1.0",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "yaml": "2.8.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
